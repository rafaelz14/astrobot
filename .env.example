# Copia este archivo como ".env" (sin ".example") y rellena los IDs reales.
# El ID de un calendario de Google se encuentra en:
# Ajustes del calendario -> "Integrar calendario" -> "ID de calendario"
# (normalmente termina en @group.calendar.google.com)

CAL_ID_RAFAEL=
CAL_ID_LAURA=
CAL_ID_JOAQUIN=
CAL_ID_SIENNA=
CAL_ID_FAMILIA=

# Zona horaria para los eventos que crea la app (obligatoria para Google
# Calendar, sin esto rechaza el evento). Formato IANA, ej. "Europe/Madrid".
TIMEZONE=Europe/Madrid

# Clima — API key gratuita en https://openweathermap.org/api
# (regístrate, "My API keys", puede tardar unos minutos en activarse)
WEATHER_API_KEY=

# Coordenadas para el clima. Por defecto, Madrid. Búscalas en Google Maps
# (clic derecho sobre tu ciudad -> aparecen lat,lon) si vives en otro sitio.
WEATHER_LAT=40.4168
WEATHER_LON=-3.7038

# Fotos — carpeta local donde sincronizas el álbum familiar (rclone, Dropbox,
# o simplemente copiando archivos a mano). Déjalo vacío para usar ./photos
# junto a app.py (el valor por defecto) — vacío es válido, no hace falta
# borrar esta línea.
PHOTOS_DIR=
